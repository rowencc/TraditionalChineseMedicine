{
  "name": "若闻小识",
  "appid": "",
  "description": "经方中医学习工具 - 基于倪海厦中医知识体系",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "optimization": {
      "subPackages": true
    },
    "requiredPrivateInfos": [],
    "permission": {
      "scope.userLocation": {
        "desc": "获取位置信息用于定位"
      }
    }
  },
  "h5": {
    "title": "若闻小识 - 经方中医学习工具",
    "router": {
      "mode": "hash"
    },
    "devServer": {
      "port": 5173,
      "disableHostCheck": true,
      "proxy": {
        "/api": {
          "target": "https://tcm.rowen.cc",
          "changeOrigin": true,
          "pathRewrite": {
            "^/api": ""
          }
        }
      }
    }
  }
}
